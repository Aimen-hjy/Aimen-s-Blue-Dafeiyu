{
  "name": "campus-agent",
  "version": "0.1.0",
  "description": "MCP server exposing SJTU campus services (Canvas, mail, timetable, classroom video, Shuiyuan BBS, todo) to DeepSeek Harness and other MCP clients.",
  "type": "module",
  "bin": {
    "campus-agent": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "imapflow": "^1.0.0",
    "nodemailer": "^6.9.0",
    "puppeteer-core": "^25.16.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
